# OncoSentinel v2.0 environment variables
# Copy to .env and fill in real values. NEVER commit .env to version control.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=oncosentinel
POSTGRES_USER=onco
POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_password

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_minio_access_key
MINIO_SECRET_KEY=CHANGE_ME_minio_secret_key

# ── Security ──────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_jwt_secret_32chars_minimum
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── OIDC (optional; leave blank for dev JWT-only mode) ─────────────────────
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME_grafana_password

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Taxonomy config ───────────────────────────────────────────────────────────
TAXONOMY_CONFIG_PATH=configs/taxonomy.yaml
THRESHOLDS_CONFIG_PATH=configs/thresholds.yaml
FAIRNESS_STRATA_CONFIG_PATH=configs/fairness_strata.yaml
