{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "OncoSentinel - Analysis Request Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "rate(http_requests_total{handler=\"/api/v2/analyze\"}[5m])",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "title": "Uncertainty Decisions (PASS / REVIEW / ABSTAIN)",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum by (decision) (onco_uncertainty_decisions_total)",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "title": "Router Distribution (Categories & Fallbacks)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum by (route) (onco_router_decisions_total)",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "title": "Clinical Workflow Latency (p95)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 Latency (s)"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["oncosentinel", "clinical-ai", "rag"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "OncoSentinel v2.0 Clinical Decision Monitoring",
  "version": 1
}
